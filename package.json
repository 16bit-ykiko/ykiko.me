{
  "name": "ykiko-me-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test \"scripts/tests/*.test.ts\"",
    "sync": "node scripts/zhihu_cli.ts sync",
    "login": "node scripts/zhihu_cli.ts login",
    "zhihu:publish": "node scripts/zhihu_cli.ts publish",
    "zhihu:update": "node scripts/zhihu_cli.ts update-article",
    "zhihu:preview": "node scripts/zhihu_cli.ts preview",
    "zhihu:roundtrip": "node scripts/zhihu_roundtrip_check.ts",
    "zhihu:test": "node scripts/tests/run_tests.ts",
    "format": "node scripts/md_format.ts --fix",
    "lint": "node scripts/md_format.ts",
    "translate": "node scripts/translate_articles.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "htmlparser2": "^12.0.0",
    "markdown-it": "^15.0.3",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
